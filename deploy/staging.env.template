# Copy with `pnpm staging:env` (recommended). Never commit deploy/staging.env.
# All REPLACE_* values are rejected by staging:preflight.
COMPOSE_PROJECT_NAME=wai-staging
WAI_IMAGE_REPOSITORY=wai-local
WAI_IMAGE_TAG=REPLACE_WITH_IMMUTABLE_IMAGE_TAG
STAGING_WEB_PORT=13000
STAGING_API_PORT=13100

POSTGRES_USER=wai_app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=wai_app
VALKEY_PASSWORD=REPLACE_WITH_RANDOM_VALKEY_PASSWORD

NODE_ENV=production
LOG_LEVEL=info
LOG_PRETTY=false
API_BASE_URL=http://127.0.0.1:13100
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:13100/v1
CORS_ORIGINS=http://127.0.0.1:13000
ENABLE_OPENAPI=false
OTEL_ENABLED=false
OTEL_EXPORTER=console

IAM_COOKIE_SECURE=true
IAM_SECRET_PEPPER=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
IAM_PII_KEYS={"staging-1":"REPLACE_WITH_BASE64_32_BYTE_AES_KEY"}
IAM_PII_KEY_ID=staging-1
SAFETY_VAULT_KEY=REPLACE_WITH_BASE64_32_BYTE_AES_KEY

# Provider-independent staging mode: uploads are unavailable and fail closed.
# Set true only after all real S3, scanner and Doubao settings are reviewed.
MEDIA_UPLOADS_ENABLED=false
MEDIA_STORAGE_ADAPTER=real
MEDIA_SCANNER_ADAPTER=real
MEDIA_SANITIZER_ADAPTER=real
MEDIA_CONTENT_MODERATION_ADAPTER=doubao

# AES-256-GCM key used only by the local backup/restore utility.
STAGING_BACKUP_KEY=REPLACE_WITH_BASE64_32_BYTE_BACKUP_KEY
