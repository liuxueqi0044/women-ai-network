# PLACEHOLDER-ONLY production contract. Never put real secrets in this file.

NODE_ENV=production
LOG_LEVEL=info
LOG_PRETTY=false

# Web is built with the versioned public API base. API_BASE_URL is the API
# origin without /v1. Replace example.com before deployment.
API_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/v1
API_HOST=0.0.0.0
API_PORT=3100
CORS_ORIGINS=https://app.example.com
ENABLE_OPENAPI=false

DATABASE_URL=postgres://APP_USER:SECRET@postgres.internal:5432/APP_DB?sslmode=require
VALKEY_URL=rediss://:SECRET@valkey.internal:6380/0
ELG_OPA_URL=http://opa.internal:8181
ELG_OPA_QUERY_TIMEOUT_MS=3000

OTEL_ENABLED=true
OTEL_EXPORTER=otlp
OTEL_OTLP_ENDPOINT=https://telemetry.example.com

IAM_COOKIE_SECURE=true
IAM_SECRET_PEPPER=REPLACE_WITH_SECRET_MANAGER_VALUE_AT_LEAST_32_CHARS
IAM_PII_KEYS={"prod-2026-01":"REPLACE_WITH_BASE64_32_BYTE_AES_KEY"}
IAM_PII_KEY_ID=prod-2026-01
SAFETY_VAULT_KEY=REPLACE_WITH_BASE64_32_BYTE_AES_KEY

# Production must not use the local mock identity provider. Leave unset until
# a reviewed real adapter has been implemented and configured.
# VERIFICATION_PROVIDER=REVIEWED_PROVIDER_ID

# Keep false until the reviewed storage/scanning/visual-review stack is ready.
# Disabled means media endpoints fail closed; it never selects fake adapters.
MEDIA_UPLOADS_ENABLED=false
MEDIA_STORAGE_ADAPTER=real
MEDIA_SCANNER_ADAPTER=real
MEDIA_SANITIZER_ADAPTER=real
MEDIA_CONTENT_MODERATION_ADAPTER=doubao
MEDIA_S3_ENDPOINT=https://media.example.com
MEDIA_S3_REGION=REPLACE_WITH_STORAGE_REGION
MEDIA_S3_QUARANTINE_BUCKET=wai-private-quarantine
MEDIA_S3_CLEAN_BUCKET=wai-private-clean
MEDIA_S3_QUARANTINE_ACCESS_KEY=SECRET_MANAGER_REFERENCE
MEDIA_S3_QUARANTINE_SECRET_KEY=SECRET_MANAGER_REFERENCE
MEDIA_S3_CLEAN_ACCESS_KEY=SECRET_MANAGER_REFERENCE
MEDIA_S3_CLEAN_SECRET_KEY=SECRET_MANAGER_REFERENCE
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310

ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=SECRET_MANAGER_REFERENCE_TO_ROTATED_KEY
ARK_VISION_MODEL=ep-REPLACE_WITH_VISUAL_ENDPOINT
ARK_VISION_TIMEOUT_MS=15000
