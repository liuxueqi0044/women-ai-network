{
  "name": "@wai/config",
  "version": "0.1.0",
  "private": true,
  "description": "Zod-validated environment configuration with production guards",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "3.24.4"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
