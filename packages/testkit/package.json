{
  "name": "@wai/testkit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared test infrastructure: containerized PostgreSQL/Valkey lifecycle and fixtures",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wai/contracts": "workspace:*",
    "otpauth": "9.5.1",
    "testcontainers": "12.1.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
