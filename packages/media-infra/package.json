{
  "name": "@wai/media-infra",
  "version": "0.1.0",
  "private": true,
  "description": "Production S3-compatible storage and privacy-bounded visual content review adapters",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
