{
  "name": "@wai/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Structured JSON logging with deep redaction, request context and OpenTelemetry initialization",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.2",
    "@opentelemetry/sdk-trace-base": "1.30.0",
    "pino": "9.6.0",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
