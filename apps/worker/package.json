{
  "name": "@wai/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Women AI Network Worker — NestJS standalone + BullMQ foundation consumer (FND-01)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
