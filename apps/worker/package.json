    "@wai/contracts": "workspace:*",
    "@wai/db": "workspace:*",
    "@wai/media-infra": "workspace:*",
    "@wai/observability": "workspace:*",
    "bullmq": "5.53.0",
    "ioredis": "5.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@wai/testkit": "workspace:*",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
