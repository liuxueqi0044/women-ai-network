# Copy this file to .env for local overrides:
#   PowerShell: Copy-Item .env.example .env
#
# The values below are safe DEVELOPMENT defaults only. They are also baked
# into compose.yaml so `docker compose up -d` works without a .env file.
# Production startup REJECTS these dev-default credentials (see packages/config).

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
# Pretty-print logs in a terminal instead of JSON (development only).
LOG_PRETTY=false

# --- Web (Next.js) ---
# Server-side only: never prefix with NEXT_PUBLIC_ unless the value is safe for browsers.
API_BASE_URL=http://127.0.0.1:3100
# Browser callers use this versioned base exactly; do not set the origin here.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3100/v1

# --- API ---
API_HOST=127.0.0.1
API_PORT=3100
# Comma-separated allowed origins. Development default targets the local web app.
# Production requires an explicit origin list and rejects '*'.
CORS_ORIGINS=http://localhost:3000
# OpenAPI document at GET /v1/docs. Disabled by default; set true to enable.
ENABLE_OPENAPI=false

# --- PostgreSQL (host port 5433) ---
# Compose host-port overrides; change BOTH the port vars and the URLs when
# running two workspaces in parallel (see docs/runbooks/local-development.md).
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://wai_dev:wai_dev_pg_8f3k@127.0.0.1:5433/wai_dev

# --- Valkey (host port 6380), used by BullMQ ---
VALKEY_HOST_PORT=6380
VALKEY_URL=redis://:wai_dev_valkey_9q2x@127.0.0.1:6380

# --- OpenTelemetry ---
# Local tracing is opt-in. Production exporters are only active when configured here.
OTEL_ENABLED=false
# console (local debugging) | otlp (production collector)
OTEL_EXPORTER=console
# OTEL_OTLP_ENDPOINT=http://127.0.0.1:4318

# --- Worker ---
# TTL (seconds) for the short-lived foundation.trace result records in Valkey.
FOUNDATION_TRACE_RESULT_TTL_SECONDS=86400

# --- ELG-01 (Eligibility policy engine) ---
# OPA Data API base URL (compose service on host port 8181). Development
# default is loopback-only; production startup REJECTS it — set explicitly.
ELG_OPA_URL=http://127.0.0.1:8181
# Per-query timeout for policy decisions; failures fail CLOSED (deny).
ELG_OPA_QUERY_TIMEOUT_MS=3000
OPA_HOST_PORT=8181

# --- IAM-01 (Account) ---
# Session lifetime: idle timeout and absolute maximum, both in seconds.
IAM_SESSION_IDLE_SECONDS=604800
IAM_SESSION_ABSOLUTE_SECONDS=2592000
# Session cookie Secure flag. Development default is false (http://localhost);
# production startup REJECTS false — set true (the __Host- prefix also
# enforces Secure regardless of this flag).
IAM_COOKIE_SECURE=false
# Pepper for keyed digests (HMAC context hashes, >= 32 chars). Development
# default is local-only; production startup REJECTS it — generate your own.
#   openssl rand -base64 32
IAM_SECRET_PEPPER=wai-dev-iam-pepper-do-not-use-in-production-01
# AES-256-GCM keys for PII at rest, JSON map of { keyId: base64-32-byte }.
# Development default is local-only; production startup REJECTS it.
#   node -e "console.log(JSON.stringify({k: require('crypto').randomBytes(32).toString('base64')}))"
IAM_PII_KEYS={"dev-key":"dUnDePcXXLNeIe+ZDKq3MveXGJ611HjLHRIDvYlNcHM="}
# Key id used for NEW ciphertexts; must exist in IAM_PII_KEYS.
IAM_PII_KEY_ID=dev-key
# IP dimension (per-route @fastify/rate-limit), one shared window in seconds.
IAM_RATE_LIMIT_IP_WINDOW_SECONDS=900
IAM_RATE_LIMIT_IP_REGISTRATIONS_MAX=30
IAM_RATE_LIMIT_IP_SESSIONS_MAX=60
IAM_RATE_LIMIT_IP_MFA_MAX=30
# Email-digest dimension consumed in services (attempts per window).
IAM_RATE_LIMIT_EMAIL_WINDOW_SECONDS=900
IAM_RATE_LIMIT_LOGIN_EMAIL_MAX=10
IAM_RATE_LIMIT_REGISTRATION_EMAIL_MAX=3

# --- VER-01 (Verification) ---
# The HMAC mock is a local compliance harness only. Production refuses it;
# leave VERIFICATION_PROVIDER unset until a reviewed real adapter is installed.
VERIFICATION_PROVIDER=mock
VERIFICATION_MOCK_SECRET=wai-dev-verification-webhook-secret-rotate-before-use
# Optional overlap window during webhook-secret rotation.
# VERIFICATION_MOCK_PREVIOUS_SECRET=

# --- MED-01 secure media + Doubao visual content review ---
# Start the optional local services with:
#   docker compose --profile media up -d --wait
# Production must use HTTPS object storage, separate least-privilege
# quarantine/clean credentials, private buckets and a private ClamAV endpoint.
MEDIA_STORAGE_ADAPTER=real
MEDIA_SCANNER_ADAPTER=real
MEDIA_SANITIZER_ADAPTER=real
MEDIA_CONTENT_MODERATION_ADAPTER=fake
MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_QUARANTINE_BUCKET=wai-private-quarantine
MEDIA_S3_CLEAN_BUCKET=wai-private-clean
MEDIA_S3_QUARANTINE_ACCESS_KEY=wai_media_dev
MEDIA_S3_QUARANTINE_SECRET_KEY=wai_media_dev_secret_9f4k2m
MEDIA_S3_CLEAN_ACCESS_KEY=wai_media_dev
MEDIA_S3_CLEAN_SECRET_KEY=wai_media_dev_secret_9f4k2m
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=wai_media_dev
MINIO_ROOT_PASSWORD=wai_media_dev_secret_9f4k2m
# Browser origins accepted by the optional local MinIO API. Production CORS
# belongs in the managed object-store configuration and must never use `*`.
MEDIA_BROWSER_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_HOST_PORT=3310

# Real Doubao/Volcengine Ark review. Never commit the key. Keep the adapter
# `fake` for local UI work; production requires `doubao` plus both variables.
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_API_KEY=place-a-rotated-key-in-local-or-deployment-secrets-only
# ARK_VISION_MODEL=ep-your-visual-endpoint
ARK_VISION_TIMEOUT_MS=15000
